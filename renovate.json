{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "packageRules": [
    {
      "description": "Auto-merge reviewdog/action-actionlint updates",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["reviewdog/action-actionlint"],
      "automerge": true
    }
  ]
}
